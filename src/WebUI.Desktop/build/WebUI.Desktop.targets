<Project>
  <!-- WebUI build pipeline -->
  <PropertyGroup>
    <WebUIDevMode Condition="'$(Configuration)' == 'Debug'">true</WebUIDevMode>
    <WebUIDevMode Condition="'$(Configuration)' != 'Debug'">false</WebUIDevMode>
    <WebUIBuildToolsPath>$(MSBuildThisFileDirectory)..\tools\build</WebUIBuildToolsPath>
    <!-- Api is now always in the same relative location -->
    <WebUIApiPath>$(MSBuildThisFileDirectory)..\Api</WebUIApiPath>
    <!-- Project-specific WebUI working directory -->
    <WebUIWorkDir>$(MSBuildProjectDirectory)\obj\webui</WebUIWorkDir>
  </PropertyGroup>

  <!-- Check if Node.js is available -->
  <Target Name="CheckNodeJS" BeforeTargets="CompilePanels">
    <Exec Command="node --version" 
          ConsoleToMSBuild="true" 
          IgnoreExitCode="true">
      <Output TaskParameter="ExitCode" PropertyName="NodeExitCode" />
    </Exec>
    
    <Error Condition="'$(NodeExitCode)' != '0'" 
           Text="Node.js is required to build WebUI panels. Please install Node.js from https://nodejs.org" />
  </Target>

  <!-- Copy build scripts to obj/webui -->
  <Target Name="CopyBuildScripts"
          BeforeTargets="CompilePanels"
          DependsOnTargets="RestoreWebUIPackages"
          Condition="'@(Panel)' != ''">
    <ItemGroup>
      <BuildFiles Include="$(WebUIBuildToolsPath)\build-panel.js" />
      <BuildFiles Include="$(WebUIBuildToolsPath)\*.css" />
      <BuildFiles Include="$(WebUIBuildToolsPath)\*.config.js" />
      <BuildFiles Include="$(WebUIBuildToolsPath)\tsconfig.json" />
    </ItemGroup>
    <Copy SourceFiles="@(BuildFiles)"
          DestinationFolder="$(WebUIWorkDir)"
          SkipUnchangedFiles="true" />
  </Target>

  <!-- Generate merged package.json using inputs/outputs for incremental build -->
  <Target Name="GeneratePackageJson" 
          Inputs="@(NpmPackage);$(MSBuildProjectFile);$(WebUIBuildToolsPath)\package.json;$(WebUIApiPath)\package.json"
          Outputs="$(WebUIWorkDir)\package.json"
          Condition="'@(Panel)' != ''">
    <MakeDir Directories="$(WebUIWorkDir)" />
    
    <!-- Build the user packages list -->
    <PropertyGroup>
      <UserPackageList>@(NpmPackage->'&quot;%(Identity)|%(Version)&quot;', ' ')</UserPackageList>
    </PropertyGroup>
    
    <!-- Merge all package.json files -->
    <Exec Command="node merge-package-json.js &quot;$(WebUIBuildToolsPath)&quot; &quot;$(WebUIApiPath)&quot; &quot;$(WebUIWorkDir)\package.json&quot; $(UserPackageList)"
          WorkingDirectory="$(WebUIBuildToolsPath)" />
  </Target>

  <!-- Generate tsconfig.json for IntelliSense -->
  <Target Name="GenerateTsConfig"
          Inputs="$(MSBuildProjectFile)"
          Outputs="$(WebUIWorkDir)\tsconfig.json"
          Condition="'@(Panel)' != ''">
    <PropertyGroup>
      <TsConfigContent>
{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "node",
    "lib": ["ES2020", "DOM"],
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "@webui/api": ["$(WebUIApiPath.Replace('\', '/'))/index.ts"],
      "@webui/components": ["$(MSBuildThisFileDirectory.Replace('\', '/'))../Components/index.ts"]
    },
    "types": ["svelte"],
    "allowJs": true,
    "checkJs": false,
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "$(MSBuildProjectDirectory.Replace('\', '/'))/**/*.ts",
    "$(MSBuildProjectDirectory.Replace('\', '/'))/**/*.js",
    "$(MSBuildProjectDirectory.Replace('\', '/'))/**/*.svelte"
  ]
}
      </TsConfigContent>
    </PropertyGroup>
    
    <WriteLinesToFile File="$(WebUIWorkDir)\tsconfig.json" 
                      Lines="$(TsConfigContent)" 
                      Overwrite="true" />
    <Message Text="📝 Generated tsconfig.json for IntelliSense" Importance="normal" />
  </Target>

  <!-- Install npm packages if needed -->
  <Target Name="RestoreWebUIPackages" 
          BeforeTargets="CompilePanels"
          DependsOnTargets="GeneratePackageJson;GenerateTsConfig"
          Condition="'@(Panel)' != ''">
    <!-- Check if we need to run npm install -->
    <PropertyGroup>
      <NpmInstallRequired>false</NpmInstallRequired>
      <NpmInstallRequired Condition="!Exists('$(WebUIWorkDir)\node_modules')">true</NpmInstallRequired>
      <NpmInstallRequired Condition="$([System.IO.File]::GetLastWriteTime('$(WebUIWorkDir)\package.json').Ticks) > $([System.IO.File]::GetLastWriteTime('$(WebUIWorkDir)\node_modules').Ticks)">true</NpmInstallRequired>
    </PropertyGroup>
    
    <Message Text="📦 Installing npm packages in $(WebUIWorkDir)..." 
             Importance="high" 
             Condition="'$(NpmInstallRequired)' == 'true'" />
    <Exec Command="npm install" 
          WorkingDirectory="$(WebUIWorkDir)"
          Condition="'$(NpmInstallRequired)' == 'true'" />
  </Target>

  <Target Name="CompilePanels" 
          BeforeTargets="BeforeBuild"
          DependsOnTargets="CheckNodeJS;RestoreWebUIPackages;CopyBuildScripts"
          Condition="'@(Panel)' != ''">
    <Message Text="🚀 WebUI: Compiling panels..." Importance="high" />
    <Message Text="📁 Dev Mode: $(WebUIDevMode)" Importance="high" />
    <Message Text="🔍 Found panels: @(Panel)" Importance="normal" />
    
    <!-- Create output directory -->
    <MakeDir Directories="$(OutputPath)panels" />
    
    <!-- Compile each panel into self-contained bundle from obj/webui -->
    <Exec Command="node build-panel.js &quot;%(Panel.FullPath)&quot; &quot;$(MSBuildProjectDirectory)\$(OutputPath)panels&quot; $(WebUIDevMode) &quot;$(MSBuildProjectDirectory)&quot; &quot;$(WebUIApiPath)&quot; &quot;$(MSBuildThisFileDirectory)..\Components&quot; &quot;$(WebUIBuildToolsPath)&quot;"
          WorkingDirectory="$(WebUIWorkDir)"
          ConsoleToMSBuild="true" />
  </Target>

  <!-- Watch target - only compiles panels, doesn't build the project -->
  <Target Name="CompilePanelsOnly" 
          DependsOnTargets="CheckNodeJS;RestoreWebUIPackages;CopyBuildScripts"
          Condition="'@(Panel)' != ''">
    <Message Text="🔄 Recompiling panels..." Importance="high" />
    
    <!-- Create output directory if needed -->
    <MakeDir Directories="$(OutputPath)panels" />
    
    <!-- Compile each panel from obj/webui -->
    <Exec Command="node build-panel.js &quot;%(Panel.FullPath)&quot; &quot;$(MSBuildProjectDirectory)\$(OutputPath)panels&quot; $(WebUIDevMode) &quot;$(MSBuildProjectDirectory)&quot; &quot;$(WebUIApiPath)&quot; &quot;$(MSBuildThisFileDirectory)..\Components&quot; &quot;$(WebUIBuildToolsPath)&quot;"
          WorkingDirectory="$(WebUIWorkDir)"
          ConsoleToMSBuild="true" />
  </Target>

  <!-- Friendly alias for watch mode -->
  <Target Name="watch" DependsOnTargets="CompilePanelsOnly">
    <Message Text="✅ Panels compiled. Watching for changes..." Importance="high" />
  </Target>
</Project>