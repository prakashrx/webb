{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020", "DOM"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "allowJs": true,
    "strict": false,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@webui/api": ["../../Api/index.ts"],
      "@webui/components": ["../../Components/index.js"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../../Api/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}